# Security headers for Cloudflare Pages.
# Script, frame, and connect allow Bokun's loader (widgets.bokun.io, static.bokun.io),
# the checkout frames it opens, and Stripe (js.stripe.com, hooks, checkout, api, m.stripe.network).
# style-src allows unsafe-inline because the Bokun widget injects its own styles.
# script-src does not allow unsafe-inline or unsafe-eval.
# Fonts are self-hosted. font-src is 'self' and data: only.
# Do not add fonts.googleapis.com or fonts.gstatic.com.
# static.cloudflareinsights.com and cloudflareinsights.com are for cookieless
# Cloudflare Web Analytics if it is turned on for the zone. connect-src 'self'
# covers the automatic /cdn-cgi/rum beacon.
# Google tag hosts are for gtag.js (Google Ads conversion and linker).
# script-src still does not allow unsafe-inline or unsafe-eval.
# The tag in main.js stays unloaded until the conversion ID and label are real.
# payment= lists the booking and Stripe frames so wallets are not blocked
# when those frames request the Payment Request API.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self "https://widgets.bokun.io" "https://bookings.bokun.io" "https://js.stripe.com" "https://hooks.stripe.com" "https://checkout.stripe.com")
  Content-Security-Policy: default-src 'self'; script-src 'self' https://widgets.bokun.io https://static.bokun.io https://js.stripe.com https://*.js.stripe.com https://*.stripe.com https://m.stripe.network https://static.cloudflareinsights.com https://www.googletagmanager.com https://www.googleadservices.com https://www.google.com https://www.google-analytics.com https://*.google-analytics.com https://googleads.g.doubleclick.net https://*.g.doubleclick.net; style-src 'self' 'unsafe-inline' https://widgets.bokun.io https://static.bokun.io; img-src 'self' data: blob: https://*.bokun.io https://*.stripe.com https://www.googletagmanager.com https://www.googleadservices.com https://www.google.com https://*.google.com https://www.google-analytics.com https://*.google-analytics.com https://googleads.g.doubleclick.net https://ad.doubleclick.net https://*.g.doubleclick.net https://pagead2.googlesyndication.com; font-src 'self' data:; connect-src 'self' https://widgets.bokun.io https://*.bokun.io https://static.bokun.io https://api.stripe.com https://checkout.stripe.com https://r.stripe.com https://q.stripe.com https://m.stripe.com https://*.stripe.com https://cloudflareinsights.com https://www.googletagmanager.com https://www.googleadservices.com https://www.google.com https://*.google.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://googleads.g.doubleclick.net https://ad.doubleclick.net https://*.g.doubleclick.net https://pagead2.googlesyndication.com; frame-src https://*.bokun.io https://js.stripe.com https://*.js.stripe.com https://hooks.stripe.com https://checkout.stripe.com https://*.stripe.com https://m.stripe.network https://www.googletagmanager.com; frame-ancestors 'self'; form-action 'self' https://*.bokun.io https://*.stripe.com https://checkout.stripe.com https://hooks.stripe.com; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=31536000, immutable
